{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm --prefix frontend run build",
  "installCommand": "npm --prefix frontend ci",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/index.py": {
      "includeFiles": "{backend,data,artifacts/calibration}/**",
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/media/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/evidence/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/demo-assets/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/demo-cases/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/scene-library/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/wall-assets/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/calibration-assets/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
