DEMO_LOCATION_MODE=true
DATABASE_URL=sqlite:///./data/geo_recheck.db
EVIDENCE_DIR=./data/images
FRONTEND_ORIGIN=http://127.0.0.1:5173
STEPFUN_API_KEY=
# Step Plan key: https://api.stepfun.com/step_plan/v1
# Ordinary Open API key: https://api.stepfun.com/v1
STEPFUN_BASE_URL=https://api.stepfun.com/step_plan/v1
STEPFUN_MODEL=step-3.7-flash
STEPFUN_TIMEOUT_SECONDS=180
STEPFUN_AI_REVIEW_ENABLED=false
# Reminder threshold only: how many days before a point's site-overview photo is flagged
# as stale in the UI. Never blocks an operation.
CONTEXT_PHOTO_STALE_DAYS=90
